<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Login</title>
    <link href="/css/user/user-login.css" rel="stylesheet" />
  </head>
  <body>

    <a href="/" class="back-btn" aria-label="Back to welcome page">Back</a>

    <main class="auth-shell">
      <section class="auth-card" aria-labelledby="login-heading">
        <div class="auth-brand">
          <span class="brand-mark">UM</span>
          <span>User Management</span>
        </div>

        <div class="auth-header">
          <p class="eyebrow">User Portal</p>
          <h1 id="login-heading">Welcome back</h1>
          <p>Sign in to continue to your account workspace.</p>
        </div>

        <form action="/user/login" method="POST" autocomplete="off">

          <label for="email-box">Email address</label>
          <input
            type="email"
            placeholder="you@example.com"
            id="email-box"
            class="input-boxes"
            name="email"
            value="luffy@onepiece.com"
          />

          <label for="pass-box">Password</label>
          <div class="password-wrapper">

            <input
              type="password"
              placeholder="Enter your password"
              id="pass-box"
              name="password"
              class="input-boxes"
              value="1452007"
            />

            <img
              src="/images/show-pass.png"
              alt="Show password"
              class="password-toggle"
              id="togglePassword"
            />
          </div>

          {{#if error}}
            <p class="form-message error-message" role="alert">{{error}}</p>
          {{/if}}

          <input type="submit" value="Login" id="button" />
          <p class="auth-switch">New here? <a href="/user/signup" id="signup">Create an account</a></p>

        </form>

      </section>
    </main>

    <script src="/js/default.js"></script>
  </body>
</html>
