<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Signup</title>
    <link href="/css/user/user-signup.css" rel="stylesheet" />
  </head>
  <body>

    <main class="auth-shell">
      <section class="auth-card" aria-labelledby="signup-heading">
        <div class="auth-brand">
          <span class="brand-mark">UM</span>
          <span>User Management</span>
        </div>

        <div class="auth-header">
          <p class="eyebrow">Create Account</p>
          <h1 id="signup-heading">Start your workspace</h1>
          <p>Set up secure access to the user portal.</p>
        </div>

        <form action="/user/signup" method="POST" autocomplete="off">

          <label for="name-box">Full name</label>
          <input
            type="text"
            placeholder="Jane Cooper"
            id="name-box"
            class="input-boxes"
            name="fname"
            required
          />

          <label for="email-box">Email address</label>
          <input
            type="email"
            placeholder="you@example.com"
            id="email-box"
            class="input-boxes"
            name="email"
            required
          />

          <label for="pass-box">Password</label>
          <div class="password-wrapper">
            <input
              type="password"
              placeholder="Create a password"
              id="pass-box"
              class="input-boxes"
              name="password"
              required
            />

            <img
              src="/images/show-pass.png"
              id="togglePassword"
              class="password-toggle"
              alt="Toggle password visibility"
            />
          </div>

          <label for="confirm-pass-box">Confirm password</label>
          <div class="password-wrapper">
            <input
              type="password"
              placeholder="Confirm your password"
              id="confirm-pass-box"
              class="input-boxes"
              name="confirm_password"
              required
            />

            <img
              src="/images/show-pass.png"
              id="toggleConfirmPassword"
              class="password-toggle"
              alt="Toggle confirm password visibility"
            />
          </div>

          {{#if error}}
            <p class="form-message error-message" role="alert">{{error}}</p>
          {{/if}}

          <input type="submit" value="Signup" id="button" />

          <p class="auth-switch">Already have an account? <a href="/user/login" id="login">Log in</a></p>

        </form>

      </section>
    </main>

    <script src="/js/default.js"></script>
  </body>
</html>
