<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>

    <link href="/css/user/user-home.css" rel="stylesheet" />

  </head>
  <body>

    <main class="user-shell">
      <nav class="topbar" aria-label="User navigation">
        <div class="brand-row">
          <span class="brand-mark">UM</span>
          <span>User Portal</span>
        </div>

        <form action="/user/logout" method="POST">
          <input type="submit" value="Logout" id="button" />
        </form>
      </nav>

      <section class="home-panel" aria-labelledby="home-heading">
        <p class="eyebrow">Signed in</p>
        <h1 id="home-heading">Hey {{name}}</h1>
        <p>Your account session is active. You can continue using the portal or sign out securely.</p>

        <div class="status-card">
          <span class="status-dot"></span>
          <div>
            <h2>Account ready</h2>
            <p>Authentication is working and your profile is available.</p>
          </div>
        </div>
      </section>
    </main>

  </body>
</html>
