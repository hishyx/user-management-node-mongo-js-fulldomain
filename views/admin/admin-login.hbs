<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <link href="/css/admin/admin-login.css" rel="stylesheet" />
  </head>
  <body>

    <a href="/" class="back-btn" aria-label="Back to welcome page">Back</a>
    <main class="auth-shell">
      <section class="auth-card" aria-labelledby="admin-login-heading">
        <div class="auth-brand">
          <span class="brand-mark">UM</span>
          <span>Admin Console</span>
        </div>

        <div class="auth-header">
          <p class="eyebrow">Administrator</p>
          <h1 id="admin-login-heading">Sign in securely</h1>
          <p>Manage users, roles, and account access.</p>
        </div>

        <form action="/admin/login" method="post" autocomplete="off">

          <label for="email-box">Email address</label>
          <input
            type="email"
            placeholder="admin@example.com"
            id="email-box"
            class="input-boxes"
            name="email"
            value="admin@system.com"
          />

          <label for="pass-box">Password</label>
          <div class="password-wrapper">

            <input
              type="password"
              placeholder="Enter your password"
            id="pass-box"
            name="password"
            class="input-boxes"
            value="2007"
          />

            <img
              src="/images/show-pass.png"
              alt="Show password"
              class="password-toggle"
              id="togglePassword"
            />

          </div>

          {{#if error}}
            <p class="form-message error-message" role="alert">{{error}}</p>
          {{/if}}

          <input type="submit" value="Login" id="button" />

        </form>
      </section>
    </main>

    <script src="/js/default.js"></script>
  </body>
</html>
